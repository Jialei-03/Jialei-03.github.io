{
  "name": "jialei-academic-homepage",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .preview/ssr && node scripts/prerender.mjs",
