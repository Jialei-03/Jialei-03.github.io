    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.62.1",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tabler/icons-react": "^3.49.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0"
